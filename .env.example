# Copy to .env and adjust. Never commit .env.
APP_NAME=SkillProof
ENVIRONMENT=local
LOG_LEVEL=INFO

# Host ports
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database / cache (backend reads DATABASE_URL / REDIS_URL directly when run outside Docker)
POSTGRES_USER=skillproof
POSTGRES_PASSWORD=skillproof
POSTGRES_DB=skillproof
DATABASE_URL=postgresql+asyncpg://skillproof:skillproof@localhost:5432/skillproof
REDIS_URL=redis://localhost:6379/0

# File storage (resumes, logos, audio). Default: local disk. `s3` = any S3-compatible service.
STORAGE_BACKEND=local        # local | s3
STORAGE_LOCAL_DIR=./var/uploads
# Only for STORAGE_BACKEND=s3:
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=skillproof

# Auth (Phase 1)
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-in-env  # use `openssl rand -hex 32` outside local

# AI providers — mock by default, no keys needed
LLM_PROVIDER=mock            # mock | openai_compatible | gemini | anthropic
LLM_MODEL=mock-1
LLM_BASE_URL=
LLM_EXTRA_BODY={}          # provider fields; DeepSeek: {"chat_template_kwargs":{"thinking":false}}
LLM_API_KEY=
STT_PROVIDER=mock
TTS_PROVIDER=mock
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=

# Global threshold defaults (spec §0.9) — any field of app/core/thresholds.py, e.g.:
# THRESHOLDS__STAGE1__PASS_THRESHOLD=70
# THRESHOLDS__INTEGRITY__PASTE_MAX_LINES=2
# THRESHOLDS__INTEGRITY__PASTE_MAX_CHARS=80
# THRESHOLDS__INTEGRITY__INACTIVITY_WARNING_S=60
# THRESHOLDS__INTEGRITY__INACTIVITY_LIMIT_S=90

# Notifications. Email: console logs the message, smtp sends it (STARTTLS).
EMAIL_BACKEND=console
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# Telegram stays off until all three are set. See docs/NOTIFICATIONS.md for the webhook.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Frontend
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SkillProof
# Telemetry WebSocket goes straight to the API (Next route handlers cannot upgrade). Inlined at build time.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Code sandbox (spec §3). `stub` runs nothing; compose uses judge0.
SANDBOX_PROVIDER=judge0
JUDGE0_AUTHN_TOKEN=change-me
JUDGE0_DB_PASSWORD=change-me
JUDGE0_REDIS_PASSWORD=change-me
