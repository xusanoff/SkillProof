# Product name shown in the UI (build-time: NEXT_PUBLIC_* is inlined into the bundle).
NEXT_PUBLIC_APP_NAME=SkillProof
# Where the /api/* route handler forwards requests (runtime; read per request).
API_INTERNAL_URL=http://localhost:8000
# Optional: browser API base (default "/api", the same-origin proxy).
# NEXT_PUBLIC_API_URL=/api
# Used by `pnpm gen:api`.
OPENAPI_URL=http://localhost:8000/openapi.json
# Used by Playwright (`pnpm test:e2e`, `pnpm screenshots`).
BASE_URL=http://localhost:3000
