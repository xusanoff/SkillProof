# Copy to .env on the server. Generate secrets with: openssl rand -hex 32
DOMAIN=hire.example.com
ENVIRONMENT=production

JWT_SECRET=
POSTGRES_PASSWORD=
JUDGE0_AUTHN_TOKEN=
JUDGE0_DB_PASSWORD=
JUDGE0_REDIS_PASSWORD=

SANDBOX_PROVIDER=judge0

# Production refuses to start while any of these is a stand-in.
# Send real candidates' data only to a provider whose terms allow it: not to a free or trial tier.
LLM_PROVIDER=openai_compatible
# Other LLM_PROVIDER values are not implemented in this application.
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Provider-specific, e.g. {"chat_template_kwargs":{"thinking":false}} to keep reasoning off.
# LLM_EXTRA_BODY={}
LLM_TIMEOUT_S=240
REPORT_TIMEOUT_S=180
REPORT_AI_PHASE_TIMEOUT_S=30
REPORT_GRADING_CONCURRENCY=3
STT_PROVIDER=google
TTS_PROVIDER=google
# Use a paid key: free-tier audio may improve Google's products.
GEMINI_API_KEY=

EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Persistent Docker volume shared by API and worker. S3 is not implemented yet.
STORAGE_BACKEND=local

# Optional. See docs/NOTIFICATIONS.md.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# USD. Keys are LLM model names or speech provider names. Without a price, cost shows as unknown.
# AI_PRICES={"model-name":{"input_per_mtok":1.0,"output_per_mtok":2.0},"stt-provider":{"per_minute":0.01}}
